# Copy to .env.docker. Use the existing GEME PostgreSQL database so current products remain available.
AEGIS_SOURCE_PATH=./path/to/aegis
GEME_DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/geme?schema=public

# POS365 access check uses the tenant host shown for your store, not api.pos365.vn.
# Example: https://695.pos365.vn. Store real credentials only in ignored .env.docker.
POS365_ENABLED=false
POS365_API_BASE_URL=
POS365_USERNAME=
POS365_PASSWORD=
POS365_BRANCH_ID=

# Local-only values. Generate unique values before sharing or using outside development.
AEGIS_SQL_PASSWORD=replace-with-a-long-random-password
AEGIS_OTP_HASHING_KEY=replace-with-a-random-key-at-least-32-characters

# Optional: use the GEME Gmail account instead of local Mailpit.
# Enable 2-Step Verification first, then create an App Password in Google Account.
# Never use or commit the normal Gmail password.
# AEGIS_EMAIL_HOST=smtp.gmail.com
# AEGIS_EMAIL_PORT=587
# AEGIS_EMAIL_ENABLE_SSL=true
# AEGIS_EMAIL_USERNAME=geme-account@gmail.com
# AEGIS_EMAIL_PASSWORD=your-16-character-app-password
# AEGIS_EMAIL_FROM_EMAIL=geme-account@gmail.com
# AEGIS_EMAIL_FROM_NAME=GEME
# Keep localhost for local testing. Use the public HTTPS AEGIS URL for real customers.
# AEGIS_EMAIL_PUBLIC_BASE_URL=http://localhost:5130
