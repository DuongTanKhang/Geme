# Copy to .env.docker. Use the existing GEME PostgreSQL database so current products remain available.
AEGIS_SOURCE_PATH=./path/to/aegis
GEME_DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/geme?schema=public

# AI Studio Phase 1: private worker-to-core authentication. Use a random key in production.
AI_CORE_SHARED_SECRET=replace-with-a-random-key-at-least-32-characters
AI_WORKER_CONCURRENCY=3
AI_STUDIO_ACTIVE_TASK_LIMIT=5
AI_STUDIO_RATE_LIMIT_PER_MINUTE=12

# Optional Phase 1 provider for generating Vietnamese content drafts.
# Keep the key only in this ignored environment file, never in NEXT_PUBLIC_*.
GEME_OPENAI_API_KEY=
GEME_OPENAI_TEXT_MODEL=gpt-6-luna
GEME_OPENAI_IMAGE_ANALYSIS_MODEL=gpt-6-luna
GEME_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Keep database storage for local work. Set provider=r2 after configuring
# a Cloudflare R2 bucket and the restricted Cloudflare Worker image gateway.
MEDIA_STORAGE_PROVIDER=database
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=
MEDIA_PUBLIC_BASE_URL=
PHOTOROOM_API_KEY=
PHOTOROOM_SANDBOX=false

# POS365 access check uses the tenant host shown for your store, not api.pos365.vn.
# Example: https://695.pos365.vn. Store real credentials only in ignored .env.docker.
POS365_ENABLED=false
POS365_API_BASE_URL=
POS365_USERNAME=
POS365_PASSWORD=
POS365_BRANCH_ID=

# Viettel Post: keep credentials here; never expose them as NEXT_PUBLIC_* variables.
# Use the Partner development API first; change to production only after VTP enables the account.
VIETTELPOST_ENABLED=false
VIETTELPOST_API_BASE_URL=https://partnerdev.viettelpost.vn
VIETTELPOST_TOKEN=
VIETTELPOST_SENDER_NAME=
VIETTELPOST_SENDER_PHONE=
VIETTELPOST_SENDER_ADDRESS=
# Configure this same random secret as the webhook token in Viettel Post Partner.
VIETTELPOST_WEBHOOK_TOKEN=

# Local-only values. Generate unique values before sharing or using outside development.
AEGIS_SQL_EDITION=Express
AEGIS_SQL_PASSWORD=replace-with-a-long-random-password
AEGIS_OTP_HASHING_KEY=replace-with-a-random-key-at-least-32-characters
AEGIS_JWT_KEY=replace-with-a-random-key-at-least-32-characters
GEME_ORDER_EMAIL_API_KEY=replace-with-a-separate-random-key-at-least-32-characters
ADMIN_AUTH_JWT_SECRET=replace-with-a-separate-random-key-at-least-32-characters

# Optional: use the GEME Gmail account instead of local Mailpit.
# Enable 2-Step Verification first, then create an App Password in Google Account.
# Never use or commit the normal Gmail password.
# AEGIS_EMAIL_HOST=smtp.gmail.com
# AEGIS_EMAIL_PORT=587
# AEGIS_EMAIL_ENABLE_SSL=true
# AEGIS_EMAIL_USERNAME=geme-account@gmail.com
# AEGIS_EMAIL_PASSWORD=your-16-character-app-password
# AEGIS_EMAIL_FROM_EMAIL=geme-account@gmail.com
# AEGIS_EMAIL_FROM_NAME=GEME
# Keep localhost for local testing. Use the public HTTPS AEGIS URL for real customers.
# AEGIS_EMAIL_PUBLIC_BASE_URL=http://localhost:5130

# Optional Meta publishing for Facebook Pages + linked Instagram Professional accounts.
# Keep every credential server-side. Select the Graph API version currently enabled for your Meta App.
# Set the exact same callback URL in Meta App > Facebook Login > Valid OAuth Redirect URIs.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_API_VERSION=v26.0
SOCIAL_META_REDIRECT_URI=http://localhost:4000/api/v1/social/meta/callback
SOCIAL_META_ADMIN_RETURN_URL=http://localhost:3001/
SOCIAL_META_ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Generate with: openssl rand -base64 32. Store securely; changing it requires reconnecting Meta.
SOCIAL_META_ENCRYPTION_KEY=
GEME_SITE_URL=https://geme.vn
SOCIAL_WORKER_CONCURRENCY=2

# Shopee Open Platform read-only order import.
# Configure this exact callback URL/domain in the Shopee Open Platform Console.
SHOPEE_ENABLED=false
SHOPEE_ENVIRONMENT=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
SHOPEE_ADMIN_RETURN_URL=
# Generate once with: openssl rand -base64 32. Preserve it to keep saved tokens decryptable.
SHOPEE_TOKEN_ENCRYPTION_KEY=
SHOPEE_INITIAL_SYNC_DAYS=30
SHOPEE_POLL_INTERVAL_MINUTES=5
SHOPEE_WORKER_CONCURRENCY=2
