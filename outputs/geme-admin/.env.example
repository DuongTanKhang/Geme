NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side VietMap API key for Search/Route APIs; never expose as NEXT_PUBLIC_*.
VIETMAP_API_KEY=
# Browser-visible VietMap tilemap key; restrict it to the domains that serve Admin.
VIETMAP_TILEMAP_KEY=

# Extra public HTTPS origins used by browser fetch/SSE; comma separated.
# Keep empty when requests use the same origin. Never put secrets here.
CSP_CONNECT_ORIGINS=
# Public media Worker origin is allowed for image downloads/previews.
MEDIA_PUBLIC_BASE_URL=
