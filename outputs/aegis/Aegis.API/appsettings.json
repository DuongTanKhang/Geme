{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenSlidingDays": 7,
    "RefreshTokenAbsoluteDays": 30,
    "SessionIdleTimeoutMinutes": 30,
    "SessionAbsoluteLifetimeDays": 30
  },
  "Email": {
    "FromName": "GEME",
    "PublicBaseUrl": "http://localhost:5130",
    "SupportEmail": "support@geme.vn"
  },
  "Otp": {
    "CodeLength": 6,
    "LifetimeMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5
  }
}