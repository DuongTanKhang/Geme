  createdByAdminId         String             @map("created_by_admin_id") @db.Uuid
  disconnectedAt           DateTime?          @map("disconnected_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                AdminUser          @relation("ShopeeConnectionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  orders                   ShopeeImportedOrder[]
  mappings                 ShopeeItemMapping[]
  syncRuns                 ShopeeSyncRun[]

  @@unique([environment, shopId])
  @@index([status, lastSyncCompletedAt])
  @@map("shopee_connections")
}

model ShopeeImportedOrder {
  id                    String                    @id @default(uuid()) @db.Uuid
  connectionId          String                    @map("connection_id") @db.Uuid
  orderSn               String                    @map("order_sn") @db.VarChar(80)
  status                String                    @db.VarChar(40)
  currency              String?                   @db.VarChar(12)
  totalAmount           Decimal?                  @map("total_amount") @db.Decimal(14, 2)
  estimatedShippingFee  Decimal?                  @map("estimated_shipping_fee") @db.Decimal(14, 2)
  actualShippingFee     Decimal?                  @map("actual_shipping_fee") @db.Decimal(14, 2)
  cod                   Boolean?
  paymentMethod         String?                   @map("payment_method") @db.VarChar(100)
  shippingCarrier       String?                   @map("shipping_carrier") @db.VarChar(120)
  createTime            DateTime                  @map("create_time") @db.Timestamptz(3)
  shopeeUpdatedAt       DateTime                  @map("shopee_updated_at") @db.Timestamptz(3)
  payTime               DateTime?                 @map("pay_time") @db.Timestamptz(3)
  recipientAddress      Json?                     @map("recipient_address")
  messageToSeller       String?                   @map("message_to_seller") @db.Text
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection            ShopeeConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  items                 ShopeeImportedOrderItem[]
  statusHistory         ShopeeOrderStatusHistory[]

  @@unique([connectionId, orderSn])
  @@index([connectionId, createTime(sort: Desc)])
  @@index([connectionId, status, createTime(sort: Desc)])
  @@map("shopee_imported_orders")
}

model ShopeeImportedOrderItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  orderId                  String                 @map("order_id") @db.Uuid
  itemId                   String                 @map("item_id") @db.VarChar(40)
  modelId                  String                 @default("") @map("model_id") @db.VarChar(40)
  itemName                 String                 @map("item_name") @db.VarChar(255)
  itemSku                  String?                @map("item_sku") @db.VarChar(120)
  modelSku                 String?                @map("model_sku") @db.VarChar(120)
  quantity                 Int
  unitPrice                Decimal?               @map("unit_price") @db.Decimal(14, 2)
  variationDiscountedPrice Decimal?               @map("variation_discounted_price") @db.Decimal(14, 2)
  modelOriginalPrice       Decimal?               @map("model_original_price") @db.Decimal(14, 2)
  modelDiscountedPrice     Decimal?               @map("model_discounted_price") @db.Decimal(14, 2)
  currency                 String?                @db.VarChar(12)
  mappedSku                String?                @map("mapped_sku") @db.VarChar(64)
  mappedProductId          String?                @map("mapped_product_id") @db.Uuid
  mappedVariantId          String?                @map("mapped_variant_id") @db.Uuid
  mappingId                String?                @map("mapping_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                    ShopeeImportedOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mapping                  ShopeeItemMapping?     @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  mappedProduct            Product?               @relation("ShopeeImportedMappedProduct", fields: [mappedProductId], references: [id], onDelete: SetNull)
  mappedVariant            ProductPriceVariant?   @relation("ShopeeImportedMappedVariant", fields: [mappedVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([mappingId])
  @@index([mappedSku])
  @@map("shopee_imported_order_items")
}

model ShopeeItemMapping {
  id             String                    @id @default(uuid()) @db.Uuid
  connectionId   String                    @map("connection_id") @db.Uuid
  itemId         String                    @map("item_id") @db.VarChar(40)
  modelId        String                    @default("") @map("model_id") @db.VarChar(40)
  productId      String                    @map("product_id") @db.Uuid
  variantId      String?                   @map("variant_id") @db.Uuid
  sku            String                    @db.VarChar(64)
  source         String                    @default("MANUAL") @db.VarChar(20)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection     ShopeeConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product        Product                   @relation("ShopeeMappingProduct", fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductPriceVariant?      @relation("ShopeeMappingVariant", fields: [variantId], references: [id], onDelete: Restrict)
  importedItems  ShopeeImportedOrderItem[]

  @@unique([connectionId, itemId, modelId])
  @@index([productId])
  @@index([variantId])
  @@map("shopee_item_mappings")
}

model ShopeeOrderStatusHistory {
  id                String                 @id @default(uuid()) @db.Uuid
  orderId           String                 @map("order_id") @db.Uuid
  status            String                 @db.VarChar(40)
  shopeeUpdatedAt   DateTime               @map("shopee_updated_at") @db.Timestamptz(3)
  observedAt        DateTime               @default(now()) @map("observed_at") @db.Timestamptz(3)
  order             ShopeeImportedOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, status, shopeeUpdatedAt])
  @@index([orderId, observedAt(sort: Desc)])
  @@map("shopee_order_status_history")
}

model ShopeeSyncRun {
  id             String           @id @default(uuid()) @db.Uuid
  connectionId   String           @map("connection_id") @db.Uuid
  status         String           @default("QUEUED") @db.VarChar(20)
  fromTime       DateTime?        @map("from_time") @db.Timestamptz(3)
  toTime         DateTime?        @map("to_time") @db.Timestamptz(3)
  ordersRead     Int              @default(0) @map("orders_read")
  ordersCreated  Int              @default(0) @map("orders_created")
  ordersUpdated  Int              @default(0) @map("orders_updated")
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(3)
  errorCode      String?          @map("error_code") @db.VarChar(80)
  retryOfId      String?          @map("retry_of_id") @db.Uuid
  createdByAdminId String?        @map("created_by_admin_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection     ShopeeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("shopee_sync_runs")
}

model SocialConnection {
  id                    String                 @id @default(uuid()) @db.Uuid
  metaUserId            String                 @map("meta_user_id") @db.VarChar(100)
  displayName           String                 @map("display_name") @db.VarChar(180)
  userTokenCiphertext   String                 @map("user_token_ciphertext") @db.Text
  userTokenExpiresAt    DateTime?              @map("user_token_expires_at") @db.Timestamptz(3)
  scopes                String[]               @default([])
  status                SocialConnectionStatus @default(ACTIVE)
  createdByAdminId      String                 @map("created_by_admin_id") @db.Uuid
  disconnectedAt        DateTime?              @map("disconnected_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             AdminUser              @relation("SocialConnectionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  accounts              SocialAccount[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("social_connections")
}

model SocialAccount {
  id                    String           @id @default(uuid()) @db.Uuid
  connectionId          String           @map("connection_id") @db.Uuid
  platform              SocialPlatform
  remoteAccountId       String           @map("remote_account_id") @db.VarChar(100)
  displayName           String           @map("display_name") @db.VarChar(180)
  username              String?          @db.VarChar(180)
  linkedPageId          String?          @map("linked_page_id") @db.VarChar(100)
  accessTokenCiphertext String           @map("access_token_ciphertext") @db.Text
  selected              Boolean          @default(false)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection            SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  targets               SocialPostTarget[]

  @@unique([platform, remoteAccountId])
  @@index([connectionId, active, selected])
  @@map("social_accounts")
}

model SocialPost {
  id                    String          @id @default(uuid()) @db.Uuid
  title                 String          @db.VarChar(180)
  status                SocialPostStatus @default(DRAFT)
  revision              Int             @default(1)
  approvedRevision      Int?            @map("approved_revision")
  approvedSnapshotHash  String?         @map("approved_snapshot_hash") @db.Char(64)
  approvedAt            DateTime?       @map("approved_at") @db.Timestamptz(3)
  approvedByAdminId     String?         @map("approved_by_admin_id") @db.Uuid
  createdByAdminId      String          @map("created_by_admin_id") @db.Uuid
  updatedByAdminId      String?         @map("updated_by_admin_id") @db.Uuid
  sourceProductId       String?         @map("source_product_id") @db.Uuid
  sourceProductVariantId String?        @map("source_product_variant_id") @db.Uuid
  sourceMarketingDraftId String?        @map("source_marketing_draft_id") @db.Uuid
  approvedSnapshot      Json?           @map("approved_snapshot")
  approvedCommerceSnapshot Json?        @map("approved_commerce_snapshot")
  approvedCommerceSnapshotHash String?  @map("approved_commerce_snapshot_hash") @db.Char(64)
  lastErrorCode         String?         @map("last_error_code") @db.VarChar(80)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             AdminUser       @relation("SocialPostCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  approvedBy            AdminUser?      @relation("SocialPostApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  updatedBy             AdminUser?      @relation("SocialPostUpdater", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  sourceProduct         Product?        @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)
  sourceProductVariant  ProductPriceVariant? @relation(fields: [sourceProductVariantId], references: [id], onDelete: SetNull)
  sourceMarketingDraft  AiMarketingDraft? @relation(fields: [sourceMarketingDraftId], references: [id], onDelete: SetNull)
  targets               SocialPostTarget[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@index([sourceProductId, createdAt(sort: Desc)])
  @@map("social_posts")
}

model SocialPostTarget {
  id                   String             @id @default(uuid()) @db.Uuid
  postId               String             @map("post_id") @db.Uuid
  accountId            String?            @map("account_id") @db.Uuid
  mediaAssetId         String?            @map("media_asset_id") @db.Uuid
  platform             SocialPlatform
  caption              String             @default("") @db.VarChar(2200)
  linkUrl              String?            @map("link_url") @db.VarChar(1000)
  linkSource           SocialLinkSource   @default(NONE) @map("link_source")
  status               SocialTargetStatus @default(DRAFT)
  approvedRevision     Int?               @map("approved_revision")
  approvedPayloadHash  String?            @map("approved_payload_hash") @db.Char(64)
  scheduledAt          DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  nextAttemptAt        DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  publishRequestedAt   DateTime?           @map("publish_requested_at") @db.Timestamptz(3)
  attemptCount          Int                @default(0) @map("attempt_count")
  remoteContainerId     String?            @map("remote_container_id") @db.VarChar(140)
  remoteMediaId         String?            @map("remote_media_id") @db.VarChar(140)
  permalink             String?            @db.Text
  publishedAt           DateTime?          @map("published_at") @db.Timestamptz(3)
  lastErrorCode         String?            @map("last_error_code") @db.VarChar(80)
  reconciliationClaimedAt DateTime?        @map("reconciliation_claimed_at") @db.Timestamptz(3)
  reconciliationClaimedByAdminId String?   @map("reconciliation_claimed_by_admin_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  post                  SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  account               SocialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  mediaAsset            MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  reconciliationClaimedBy AdminUser?      @relation("SocialTargetReconciliationClaim", fields: [reconciliationClaimedByAdminId], references: [id], onDelete: SetNull)
  attempts              SocialPublishAttempt[]
  reconciliations       SocialTargetReconciliation[]

  @@unique([postId, accountId])
  @@index([status, scheduledAt])
  @@index([publishRequestedAt, status])
  @@index([reconciliationClaimedAt])
  @@map("social_post_targets")
}

model SocialTargetReconciliation {
  id                  String                         @id @default(uuid()) @db.Uuid
  targetId            String                         @map("target_id") @db.Uuid
  adminId             String                         @map("admin_id") @db.Uuid
  revision            Int
  decision            SocialReconciliationDecision
  source              SocialReconciliationSource
  remoteIdQueried     String?                        @map("remote_id_queried") @db.VarChar(140)
  resultCode          String?                        @map("result_code") @db.VarChar(80)
  notes               String?                        @db.VarChar(1200)
  evidenceReference   String?                        @map("evidence_reference") @db.VarChar(2000)
  publishedAtReported DateTime?                      @map("published_at_reported") @db.Timestamptz(3)
  createdAt           DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  target              SocialPostTarget               @relation(fields: [targetId], references: [id], onDelete: Restrict)
  admin               AdminUser                      @relation("SocialTargetReconciliationActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([targetId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("social_target_reconciliations")
}

model SocialPublishAttempt {
  id                  String              @id @default(uuid()) @db.Uuid
  targetId            String              @map("target_id") @db.Uuid
  revision            Int
  attemptNumber       Int                 @map("attempt_number")
  idempotencyKey      String              @unique @map("idempotency_key") @db.VarChar(180)
  status              SocialAttemptStatus @default(RUNNING)
  errorCode           String?             @map("error_code") @db.VarChar(80)
  remoteContainerId   String?             @map("remote_container_id") @db.VarChar(140)
  remoteMediaId       String?             @map("remote_media_id") @db.VarChar(140)
  startedAt           DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt          DateTime?           @map("finished_at") @db.Timestamptz(3)
  target              SocialPostTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, revision, attemptNumber])
  @@index([targetId, startedAt(sort: Desc)])
  @@map("social_publish_attempts")
}
