generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CONTENT_EDITOR

  @@map("admin_role")
}

enum AiTaskType {
  CONTENT_DRAFT
  IMAGE_GENERATION
  IMAGE_STUDIO_PROCESSING
  PRODUCT_DRAFT_GENERATION
  PRODUCT_PUBLICATION_PROPOSAL
  SALES_ANSWER
  MARKETING_DRAFT_GENERATION

  @@map("ai_task_type")
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  APPROVED
  REJECTED

  @@map("ai_task_status")
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("ai_approval_status")
}

enum AiImagePreset {
  STONE_GREY
  WARM_IVORY
  SOFT_SAGE

  @@map("ai_image_preset")
}

enum AiImagePurpose {
  PRODUCT_PHOTO
  TECHNICAL_DRAWING

  @@map("ai_image_purpose")
}

enum ProductMediaTag {
  PRODUCT_IMAGE
  TECHNICAL_DRAWING
  TECHNICAL_VIDEO
  CERTIFICATE
  OTHER

  @@map("product_media_tag")
}

enum AiImageBatchStatus {
  UPLOADING
  PROCESSING
  REVIEW
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED

  @@map("ai_image_batch_status")
}

enum AiImageItemStatus {
  PENDING_UPLOAD
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  FAILED
  CANCELLED

  @@map("ai_image_item_status")
}

enum AiImageQcStatus {
  PENDING
  PASS
  REVIEW
  FAIL

  @@map("ai_image_qc_status")
}

enum AiProductDraftBatchStatus {
  PROCESSING
  REVIEW
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED

  @@map("ai_product_draft_batch_status")
}

enum AiProductDraftStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  FAILED
  CANCELLED

  @@map("ai_product_draft_status")
}

enum AiSalesKnowledgeStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("ai_sales_knowledge_status")
}

enum AiMarketingDraftStatus {
  QUEUED
  GENERATING
  DRAFT
  APPROVED
  REJECTED
  FAILED
  CANCELLED

  @@map("ai_marketing_draft_status")
}

enum SocialPlatform {
  FACEBOOK_PAGE
  INSTAGRAM
  @@map("social_platform")
}

enum SocialConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
  @@map("social_connection_status")
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
  UNKNOWN
  CANCELLED
  @@map("social_post_status")
}

enum SocialTargetStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  UNKNOWN
  CANCELLED
  @@map("social_target_status")
}

enum SocialAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
  @@map("social_attempt_status")
}

enum SocialLinkSource {
  NONE
  PRODUCT
  MANUAL
  @@map("social_link_source")
}

enum SocialReconciliationDecision {
  CONFIRMED_PUBLISHED
  CONFIRMED_NOT_PUBLISHED
  UNRESOLVED
  RETRY_AUTHORIZED
  @@map("social_reconciliation_decision")
}

enum SocialReconciliationSource {
  META_API
  MANUAL
  @@map("social_reconciliation_source")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum ProductKind {
  JEWELRY
  GEMSTONE

  @@map("product_kind")
}

enum CategoryUsage {
  PRODUCT_CATEGORY
  GEMSTONE_TYPE

  @@map("category_usage")
}

enum CategoryPricingMode {
  FIXED
  QUALITY
  QUALITY_AND_BEAD_SIZE
  GEMSTONE_SIZE
  GEMSTONE_CARAT
  GEMSTONE_CARAT_AND_QUALITY

  @@map("category_pricing_mode")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

enum MaterialOptionScope {
  JEWELRY
  GEMSTONE

  @@map("material_option_scope")
}

enum MaterialOptionKind {
  MATERIAL
  STONE

  @@map("material_option_kind")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING_CONFIRMATION
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
  CREDIT_CARD
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  GIFT
  POINTS

  @@map("promotion_type")
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED

  @@map("promotion_status")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED

  @@map("blog_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

model AdminUser {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(120)
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true) @map("is_active")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil  DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  blogPosts    BlogPost[]
  auditLogs    AuditLog[]
  aiTasks      AiTask[]     @relation("AiTaskRequester")
  aiApprovals  AiApproval[] @relation("AiApprovalReviewer")
  aiImageBatches AiImageBatch[] @relation("AiImageBatchCreator")
  aiProductDraftBatches AiProductDraftBatch[] @relation("AiProductDraftBatchCreator")
  aiProductDraftReviews AiProductDraft[] @relation("AiProductDraftReviewer")
  aiSalesKnowledgeCreated AiSalesKnowledgeSource[] @relation("AiSalesKnowledgeCreator")
  aiSalesKnowledgeReviewed AiSalesKnowledgeSource[] @relation("AiSalesKnowledgeReviewer")
  aiMarketingDraftsCreated AiMarketingDraft[] @relation("AiMarketingDraftCreator")
  aiMarketingDraftsReviewed AiMarketingDraft[] @relation("AiMarketingDraftReviewer")
  socialOAuthStates SocialOAuthState[]
  socialConnectionsCreated SocialConnection[] @relation("SocialConnectionCreator")
  socialPostsCreated SocialPost[] @relation("SocialPostCreator")
  socialPostsApproved SocialPost[] @relation("SocialPostApprover")
  socialPostsUpdated SocialPost[] @relation("SocialPostUpdater")
  socialTargetReconciliations SocialTargetReconciliation[] @relation("SocialTargetReconciliationActor")
  socialReconciliationClaims SocialPostTarget[] @relation("SocialTargetReconciliationClaim")
  shopeeOAuthStates ShopeeOAuthState[] @relation("ShopeeOAuthStateAdmin")
  shopeeConnectionsCreated ShopeeConnection[] @relation("ShopeeConnectionCreator")
  contactInquiriesHandled ContactInquiry[] @relation("ContactInquiryHandler")
  paymentRecords Payment[] @relation("PaymentRecordedBy")
  permissionGrants AdminPermissionGrant[] @relation("PermissionSubject")
  permissionsGranted AdminPermissionGrant[] @relation("PermissionGrantedBy")

  @@map("admin_users")
}

model AdminPermissionGrant {
  adminId          String    @map("admin_id") @db.Uuid
  permission       String    @db.VarChar(80)
  effect           String    @default("ALLOW") @db.VarChar(8)
  grantedByAdminId String?   @map("granted_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  admin            AdminUser @relation("PermissionSubject", fields: [adminId], references: [id], onDelete: Cascade)
  grantedBy        AdminUser? @relation("PermissionGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@id([adminId, permission])
  @@index([permission, effect])
  @@map("admin_permission_grants")
}

model ContactInquiry {
  id               String    @id @default(uuid()) @db.Uuid
  idempotencyKey   String    @unique @map("idempotency_key") @db.VarChar(128)
  requestHash      String    @map("request_hash") @db.VarChar(64)
  name             String    @db.VarChar(120)
  email            String    @db.VarChar(320)
  phone            String    @db.VarChar(32)
  subject          String    @db.VarChar(80)
  message          String    @db.Text
  status           String    @default("NEW") @db.VarChar(20)
  resolutionNote   String?   @map("resolution_note") @db.Text
  handledByAdminId String?   @map("handled_by_admin_id") @db.Uuid
  handledAt        DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  handledBy        AdminUser? @relation("ContactInquiryHandler", fields: [handledByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("contact_inquiries")
}

model Customer {
  id             String           @id @default(uuid()) @db.Uuid
  code           String?          @unique @db.VarChar(32)
  authSubjectId  String?          @unique @map("auth_subject_id") @db.Uuid
  name           String           @db.VarChar(160)
  email          String?          @unique @db.VarChar(320)
  phone          String?          @unique @db.VarChar(32)
  pos365PartnerId String?         @unique @map("pos365_partner_id") @db.VarChar(80)
  defaultAddress String?          @map("default_address") @db.Text
  status         CustomerStatus   @default(ACTIVE)
  segment        String?          @db.VarChar(40)
  avatarUrl      String?          @map("avatar_url") @db.Text
  note           String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders         Order[]
  reviews        ProductReview[]
  promotions     PromotionUsage[]
  favorites      CustomerFavorite[]

  @@index([status, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([name])
  @@map("customers")
}

model Category {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(120)
  slug             String              @unique @db.VarChar(160)
  kind             ProductKind
  usage            CategoryUsage       @default(PRODUCT_CATEGORY)
  level            Int                 @default(1)
  pricingMode      CategoryPricingMode @default(FIXED) @map("pricing_mode")
  parentId         String?             @map("parent_id") @db.Uuid
  description      String?             @db.Text
  status           CategoryStatus      @default(ACTIVE)
  sortOrder        Int                 @default(0) @map("sort_order")
  imageUrl         String?             @map("image_url") @db.Text
  bannerUrl        String?             @map("banner_url") @db.Text
  seoTitle         String?             @map("seo_title") @db.VarChar(180)
  seoDescription   String?             @map("seo_description") @db.VarChar(320)
  isHot            Boolean             @default(false) @map("is_hot")
  jewelryStoneGroupId String?             @map("jewelry_stone_group_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent           Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]          @relation("CategoryTree")
  products         Product[]           @relation("ProductCategory")
  gemstoneProducts Product[]           @relation("GemstoneType")
  promotionTargets PromotionTarget[]
  jewelryStoneGroup   JewelryStoneGroup?  @relation(fields: [jewelryStoneGroupId], references: [id], onDelete: SetNull)

  @@index([parentId, level, status, sortOrder])
  @@index([kind, usage, status])
  @@map("categories")
}

model MaterialOption {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @db.VarChar(120)
  slug      String              @db.VarChar(160)
  scope     MaterialOptionScope
  kind      MaterialOptionKind  @default(STONE)
  active    Boolean             @default(true)
  imageUrl  String?             @map("image_url") @db.Text
  sortOrder Int                 @default(0) @map("sort_order")
  jewelryStoneGroupId String?             @map("jewelry_stone_group_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]
  jewelryStoneGroup   JewelryStoneGroup?  @relation(fields: [jewelryStoneGroupId], references: [id], onDelete: SetNull)

  @@unique([scope, slug])
  @@index([scope, kind, active, sortOrder])
  @@map("material_options")
}

model JewelryStoneGroup {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0) @map("sort_order")
  pinnedOrder Int?             @map("pinned_order")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]
  categories  Category[]
  materials   MaterialOption[]

  @@index([active, pinnedOrder, sortOrder])
  @@map("jewelry_stone_groups")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  sku                   String                 @unique @db.VarChar(64)
  name                  String                 @db.VarChar(180)
  slug                  String                 @unique @db.VarChar(220)
  kind                  ProductKind
  categoryId            String?                @map("category_id") @db.Uuid
  gemstoneTypeId        String?                @map("gemstone_type_id") @db.Uuid
  materialOptionId      String?                @map("material_option_id") @db.Uuid
  description           String?                @db.Text
  fullDescription       String?                @map("full_description") @db.Text
  coverVideoUrl         String?                @map("cover_video_url") @db.Text
  technicalImageUrl     String?                @map("technical_image_url") @db.Text
  technicalVideoUrl     String?                @map("technical_video_url") @db.Text
  weightGrams           Decimal?               @map("weight_grams") @db.Decimal(8, 2)
  lengthCm              Decimal?               @map("length_cm") @db.Decimal(8, 2)
  widthCm               Decimal?               @map("width_cm") @db.Decimal(8, 2)
  heightCm              Decimal?               @map("height_cm") @db.Decimal(8, 2)
  status                ProductStatus          @default(DRAFT)
  isNew                 Boolean                @default(false) @map("is_new")
  newUntil                     DateTime?                 @map("new_until") @db.Timestamptz(3)
  firstPublishedAt             DateTime?                 @map("first_published_at") @db.Timestamptz(3)
  publicationHistoryKnown      Boolean                   @default(false) @map("publication_history_known")
  jewelryStoneGroupId          String?                   @map("jewelry_stone_group_id") @db.Uuid
  isFeatured            Boolean                @default(false) @map("is_featured")
    isPremiumGemstone      Boolean                @default(false) @map("is_premium_gemstone")
  price                 Decimal?               @db.Decimal(14, 0)
  originalPrice         Decimal?               @map("original_price") @db.Decimal(14, 0)
  stock                 Int                    @default(0)
  minimumStock          Int                    @default(5) @map("minimum_stock")
    soldOutAt             DateTime?               @map("sold_out_at") @db.Timestamptz(3)
  pos365PriceSyncStatus String?                 @map("pos365_price_sync_status") @db.VarChar(20)
  pos365PriceSyncAttempts Int                   @default(0) @map("pos365_price_sync_attempts")
  pos365PriceSyncLastAttemptAt DateTime?        @map("pos365_price_sync_last_attempt_at") @db.Timestamptz(3)
  pos365PriceSyncNextAttemptAt DateTime?        @map("pos365_price_sync_next_attempt_at") @db.Timestamptz(3)
  pos365PriceSyncedAt    DateTime?              @map("pos365_price_synced_at") @db.Timestamptz(3)
  pos365PriceSyncError   String?                 @map("pos365_price_sync_error") @db.Text
  pos365StockSyncStatus String?                  @map("pos365_stock_sync_status") @db.VarChar(20)
  pos365StockSyncAttempts Int                    @default(0) @map("pos365_stock_sync_attempts")
  pos365StockSyncLastAttemptAt DateTime?          @map("pos365_stock_sync_last_attempt_at") @db.Timestamptz(3)
  pos365StockSyncNextAttemptAt DateTime?          @map("pos365_stock_sync_next_attempt_at") @db.Timestamptz(3)
  pos365StockSyncedAt DateTime?                   @map("pos365_stock_synced_at") @db.Timestamptz(3)
  pos365StockSyncError String?                    @map("pos365_stock_sync_error") @db.Text
  pos365ImageSyncStatus String?                   @map("pos365_image_sync_status") @db.VarChar(20)
  pos365ImageSyncAttempts Int                      @default(0) @map("pos365_image_sync_attempts")
  pos365ImageSyncLastAttemptAt DateTime?          @map("pos365_image_sync_last_attempt_at") @db.Timestamptz(3)
  pos365ImageSyncNextAttemptAt DateTime?          @map("pos365_image_sync_next_attempt_at") @db.Timestamptz(3)
  pos365ImageSyncedAt DateTime?                   @map("pos365_image_synced_at") @db.Timestamptz(3)
  pos365ImageSyncError String?                    @map("pos365_image_sync_error") @db.Text
  seoTitle              String?                @map("seo_title") @db.VarChar(180)
  seoDescription        String?                @map("seo_description") @db.VarChar(320)
  kiotVietProductId     String?                @unique @map("kiot_viet_product_id") @db.VarChar(80)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  category              Category?              @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  gemstoneType          Category?              @relation("GemstoneType", fields: [gemstoneTypeId], references: [id], onDelete: SetNull)
  materialOption        MaterialOption?        @relation(fields: [materialOptionId], references: [id], onDelete: SetNull)
  jewelryStoneGroup            JewelryStoneGroup?        @relation(fields: [jewelryStoneGroupId], references: [id], onDelete: SetNull)
  images                ProductImage[]
  pos365ImageLinks       Pos365ProductImageSync[]
  aiImageItems          AiImageItem[]
  variants              ProductPriceVariant[]
  reviews               ProductReview[]
  favorites             CustomerFavorite[]
  orderItems            OrderItem[]
  promotionTargets      PromotionTarget[]
  inventoryMovements    InventoryMovement[]
  inventoryReceiptItems InventoryReceiptItem[]
  inventoryIssueItems   InventoryIssueItem[]
  inventoryReservations InventoryReservation[]
  returnItems            OrderReturnItem[]
  aiTechnicalImageBatches AiImageBatch[]      @relation("AiTechnicalImageTarget")
  mediaAssets           ProductMediaAsset[]
  socialPostSources     SocialPost[]
  shopeeMappings        ShopeeItemMapping[] @relation("ShopeeMappingProduct")
  shopeeImportedItems   ShopeeImportedOrderItem[] @relation("ShopeeImportedMappedProduct")

  @@index([kind, status, createdAt(sort: Desc)])
  @@index([status, isNew, createdAt(sort: Desc)])
  @@index([kind, status, firstPublishedAt(sort: Desc), id])
  @@index([kind, status, isNew, newUntil, firstPublishedAt(sort: Desc)])
  @@index([jewelryStoneGroupId, status, firstPublishedAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([gemstoneTypeId, status, createdAt(sort: Desc)])
  @@index([materialOptionId, status, createdAt(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, stock, soldOutAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([pos365PriceSyncStatus, pos365PriceSyncNextAttemptAt])
  @@index([pos365StockSyncStatus, pos365StockSyncNextAttemptAt])
  @@index([pos365ImageSyncStatus, pos365ImageSyncNextAttemptAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.Text
  alt       String?  @db.VarChar(240)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Pos365ProductImageSync {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @db.VarChar(64)
  pos365ImageId String   @map("pos365_image_id") @db.VarChar(32)
  imageUrl      String   @map("image_url") @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sku, pos365ImageId])
  @@index([productId, sku])
  @@map("pos365_product_image_sync")
}

model ProductMediaAsset {
  id                    String          @id @default(uuid()) @db.Uuid
  productId             String          @map("product_id") @db.Uuid
  mediaAssetId          String          @map("media_asset_id") @db.Uuid
  tag                   ProductMediaTag
  sourceAiImageItemId   String?         @map("source_ai_image_item_id") @db.Uuid
  approvedByAdminId     String?         @map("approved_by_admin_id") @db.Uuid
  approvedAt            DateTime?       @map("approved_at") @db.Timestamptz(3)
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  product               Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset            MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([mediaAssetId, tag])
  @@index([productId, tag, createdAt(sort: Desc)])
  @@index([sourceAiImageItemId])
  @@map("product_media_assets")
}

model ProductPriceVariant {
  id                    String                 @id @default(uuid()) @db.Uuid
  productId             String                 @map("product_id") @db.Uuid
  optionKey             String                 @map("option_key") @db.VarChar(100)
  quality               String                 @db.VarChar(40)
  shape                 String?                @db.VarChar(20)
  beadSize              String?                @map("bead_size") @db.VarChar(24)
  carat                 Decimal?               @db.Decimal(8, 3)
  gemstoneQuality       String?                @map("gemstone_quality") @db.VarChar(40)
  sku                   String?                @unique @db.VarChar(64)
  imageUrls             String[]               @default([]) @map("image_urls")
  videoUrl              String?                @map("video_url") @db.Text
  price                 Decimal                @db.Decimal(14, 0)
  originalPrice         Decimal?               @map("original_price") @db.Decimal(14, 0)
  stock                 Int                    @default(0)
  sortOrder             Int                    @default(0) @map("sort_order")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryMovements    InventoryMovement[]
  inventoryReceiptItems InventoryReceiptItem[]
  inventoryIssueItems   InventoryIssueItem[]
  inventoryReservations InventoryReservation[]
  returnItems            OrderReturnItem[]
