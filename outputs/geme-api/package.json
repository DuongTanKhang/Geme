{
  "name": "geme-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx dist/main.js",
    "ai:worker": "node dist/ai-studio/ai-studio.worker.js",
    "social:worker": "node dist/social/social.worker.js",
    "test": "tsx --test src/ai-studio/ai-studio.contract.spec.ts src/ai-studio/ai-product-agent.contract.spec.ts src/ai-studio/ai-phase-four.contract.spec.ts src/commerce/checkout-pricing.spec.ts src/social/social.contract.spec.ts src/social/social-meta.client.spec.ts src/social/social.service.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "blog:migrate-images": "tsx scripts/migrate-blog-images.ts",
    "media:migrate-r2": "tsx scripts/migrate-media-assets-to-r2.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.16",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
