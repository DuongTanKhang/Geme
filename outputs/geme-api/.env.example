NODE_ENV=development
PORT=4000
GEME_SITE_URL=https://geme.vn
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/geme?schema=public
AEGIS_AUTH_API_URL=http://127.0.0.1:5130
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379/2

# Shopee Open Platform (optional; all secrets remain server-side).
SHOPEE_ENABLED=false
SHOPEE_ENVIRONMENT=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://127.0.0.1:4000/api/v1/shopee/callback
SHOPEE_ADMIN_RETURN_URL=http://127.0.0.1:3001/?view=shopee
SHOPEE_TOKEN_ENCRYPTION_KEY=
SHOPEE_INITIAL_SYNC_DAYS=30
SHOPEE_POLL_INTERVAL_MINUTES=5
SHOPEE_WORKER_CONCURRENCY=2
AI_CORE_URL=http://127.0.0.1:8000
AI_CORE_SHARED_SECRET=replace-with-a-random-key-at-least-32-characters
AI_WORKER_CONCURRENCY=3
AI_STUDIO_ACTIVE_TASK_LIMIT=5
AI_STUDIO_RATE_LIMIT_PER_MINUTE=12
PHOTOROOM_CONFIGURED=false
PHOTOROOM_SANDBOX=false
MEDIA_STORAGE_PROVIDER=database
# Set provider=r2 only after configuring the Cloudflare R2 bucket and keys.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=
# Public custom domain, e.g. https://media.geme.vn (leave blank for API delivery).
MEDIA_PUBLIC_BASE_URL=
ADMIN_AUTH_JWT_SECRET=replace-with-a-random-key-at-least-32-characters
API_READ_REQUESTS_PER_MINUTE=30000
API_WRITE_REQUESTS_PER_MINUTE=120
# Set only when the API is behind a trusted reverse proxy/load balancer.
# TRUST_PROXY_HOPS=1

# Viettel Post Partner API. Secrets belong to the backend only.
VIETTELPOST_ENABLED=false
VIETTELPOST_API_BASE_URL=https://partnerdev.viettelpost.vn
VIETTELPOST_TOKEN=
VIETTELPOST_SENDER_NAME=
VIETTELPOST_SENDER_PHONE=
VIETTELPOST_SENDER_ADDRESS=
VIETTELPOST_WEBHOOK_TOKEN=

# Optional bootstrap account. Set both before running `pnpm db:seed`.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-long-random-password
