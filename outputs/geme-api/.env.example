NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/geme?schema=public
AEGIS_AUTH_API_URL=http://127.0.0.1:5130
DB_POOL_MAX=20
API_READ_REQUESTS_PER_MINUTE=30000
API_WRITE_REQUESTS_PER_MINUTE=120
# Set only when the API is behind a trusted reverse proxy/load balancer.
# TRUST_PROXY_HOPS=1

# Viettel Post Partner API. Secrets belong to the backend only.
VIETTELPOST_ENABLED=false
VIETTELPOST_API_BASE_URL=https://partnerdev.viettelpost.vn
VIETTELPOST_TOKEN=
VIETTELPOST_SENDER_NAME=
VIETTELPOST_SENDER_PHONE=
VIETTELPOST_SENDER_ADDRESS=
VIETTELPOST_WEBHOOK_TOKEN=

# Optional bootstrap account. Set both before running `pnpm db:seed`.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-long-random-password
