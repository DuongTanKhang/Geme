# Copy to .env on the VPS. Generate fresh random passwords on the VPS; never commit .env.
ACME_EMAIL=
POSTGRES_PASSWORD=
ADMIN_AUTH_JWT_SECRET=
GEME_ORDER_EMAIL_API_KEY=

# Isolated Aegis authentication database. Use a password with uppercase, lowercase,
# number, and symbol; keep it identical in AEGIS_SQL_PASSWORD only.
AEGIS_SQL_PASSWORD=
AEGIS_OTP_HASHING_KEY=
AEGIS_JWT_KEY=

# SMTP settings used by registration and verification OTP emails.
AEGIS_EMAIL_HOST=smtp.gmail.com
AEGIS_EMAIL_PORT=587
AEGIS_EMAIL_ENABLE_SSL=true
AEGIS_EMAIL_USERNAME=
AEGIS_EMAIL_PASSWORD=
AEGIS_EMAIL_FROM_EMAIL=
AEGIS_EMAIL_FROM_NAME=GEME

# Optional initial Admin bootstrap; use a production-only email and password (12+ chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public Worker URL for the production media bucket. Confirm the Worker is bound
# to production media, not the staging bucket, before setting this value.
MEDIA_PUBLIC_BASE_URL=https://geme-public-media.geme-media-gateway.workers.dev
MEDIA_STORAGE_PROVIDER=r2
# Server-side VietMap API key for storefront address search/reverse and Admin Search/Route; never expose as NEXT_PUBLIC_*.
VIETMAP_API_KEY=
# Browser-visible VietMap tilemap key; restrict referrers to geme.vn and gemedashboard.geme.vn.
VIETMAP_TILEMAP_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=geme-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=media-geme
R2_REQUEST_TIMEOUT_MS=15000

# Shopee production integration. Leave disabled until the production app and
# shop are approved. Generate the encryption key with
# `openssl rand -base64 32` and keep all values only in the VPS .env.
SHOPEE_ENABLED=false
SHOPEE_ENVIRONMENT=production
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://gemedashboard.geme.vn/api/v1/shopee/callback
SHOPEE_ADMIN_RETURN_URL=https://gemedashboard.geme.vn/?view=shopee
SHOPEE_TOKEN_ENCRYPTION_KEY=
SHOPEE_INITIAL_SYNC_DAYS=30
SHOPEE_POLL_INTERVAL_MINUTES=5
SHOPEE_WORKER_CONCURRENCY=2

# Optional POS365 connection for Admin → Settings → POS365.
# Leave POS365_ENABLED=false for read-only connection checks. Enabling it allows
# production actions and queued jobs to write to the selected POS365 store.
POS365_ENABLED=false
# Keep GEME customer/order history out of the shared POS. Set true only if order sync is explicitly re-enabled.
POS365_ORDER_SYNC_ENABLED=false
POS365_API_BASE_URL=
POS365_USERNAME=
POS365_PASSWORD=
POS365_BRANCH_ID=
POS365_ACCOUNT_ID_BANK_TRANSFER=

# SePay bank account lookup + webhook payment confirmation. Keep both credentials only in this VPS .env.
SEPAY_WEBHOOK_ENABLED=false
SEPAY_WEBHOOK_SECRET=
# API Token fetches the single active linked account; it has full access and must remain server-side.
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
# Temporary fallback for old deployments only; remove after setting SEPAY_API_TOKEN.
SEPAY_ACCOUNT_NUMBERS=

# Gmail Admin inbox OAuth (optional). Create a Google OAuth Web client.
# Add https://gemedashboard.geme.vn as an Authorized JavaScript origin, and add the
# exact callback below under Authorized redirect URIs. Keep client secret server-side.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://gemedashboard.geme.vn/api/v1/integrations/gmail/callback
# Generate once with `openssl rand -base64 32`; keep stable while ciphertext exists in DB.
GMAIL_OAUTH_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_ADMIN_RETURN_URL=https://gemedashboard.geme.vn/

# Shared API quota namespace for production. Keep separate from staging.
API_RATE_LIMIT_PREFIX=geme:production:rate-limit:v1
# Optional comma-separated HTTPS origins allowed for browser fetch. No secrets.
CSP_CONNECT_ORIGINS=
